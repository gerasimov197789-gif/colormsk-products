@media(max-width:480px){.t-header .t-contacts{flex-direction:column;align-items:center;gap:6px}.t-sidebar-right .t-sidebar-card{min-width:100%}.t-products-grid{grid-template-columns:1fr}.t-product-card{min-height:300px}.t-product-image{height:100px}.t-product-brand{font-size:13px}.t-product-name{font-size:12px}.t-product-price{font-size:16px}.t-home-grid{grid-template-columns:1fr 1fr}.t-home-image-wrapper{height:100px}.t-home-title{font-size:13px}.t-home-desc{font-size:10px}.t-home-card{padding:12px;gap:8px}.t-cart-fab{width:50px;height:50px;font-size:22px;bottom:16px;right:16px}}
.t-omnibar,.t-omnibar__wrapper,.t-footer__bottom,.t-footer__made{display:none!important}
@media(max-width:768px){.t-header{padding:4px 8px!important;gap:4px!important;flex-wrap:nowrap!important;position:sticky!important;top:0!important;z-index:1000!important;background:rgba(0,0,0,0.75)!important;backdrop-filter:blur(8px)!important;border-bottom:1px solid rgba(255,255,255,0.05)!important;min-height:40px!important;align-items:center!important}.t-header .t-logo{gap:4px!important;flex-shrink:0!important}.t-header .t-logo .t-logo-img{height:24px!important;width:auto!important}.t-header .t-logo a{font-size:13px!important;font-weight:600!important;color:#fff!important}.t-header .t-logo .t-slogan{display:none!important}.t-header .t-contacts{gap:4px!important;flex-shrink:0!important;flex-wrap:nowrap!important}.t-header .t-contacts a{font-size:9px!important;gap:2px!important;color:rgba(255,255,255,0.8)!important;white-space:nowrap!important}#t-search-header-container{max-width:100px!important;min-width:50px!important;margin:0 2px 0 auto!important;flex-shrink:1!important}#t-search-header-container input{padding:2px 6px!important;font-size:9px!important;border-radius:12px!important;background:rgba(255,255,255,0.1)!important;border:1px solid rgba(255,255,255,0.15)!important;color:#fff!important}#t-search-header-container input::placeholder{font-size:8px!important;color:rgba(255,255,255,0.5)!important}}
@media(max-width:480px){.t-header{padding:2px 4px!important;min-height:34px!important;gap:2px!important}.t-header .t-logo .t-logo-img{height:18px!important}.t-header .t-logo a{font-size:11px!important}.t-header .t-contacts a{font-size:7px!important}#t-search-header-container{max-width:70px!important;min-width:40px!important}#t-search-header-container input{padding:1px 4px!important;font-size:7px!important}#t-search-header-container input::placeholder{font-size:6px!important}}
</style>
