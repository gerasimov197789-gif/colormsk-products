// КОРЗИНА
let cart = [];
function loadCart(){try{const s=localStorage.getItem('colormsk_cart');if(s)cart=JSON.parse(s);else cart=[]}catch(e){cart=[]}updateCartUI()}
function saveCart(){localStorage.setItem('colormsk_cart',JSON.stringify(cart));updateCartUI()}
function addToCart(product){
    const key = product.sku + (product.color ? '|' + product.color : '') + (product.gloss ? '|' + product.gloss : '');
    const existing = cart.find(item => item.key === key);
    if(existing){existing.qty += 1}else{
        cart.push({key:key,brand:product.brand,name:product.name,sku:product.sku,price:product.price,
        color:product.color||'',gloss:product.gloss||'',volume:product.volume||'',fill:product.fill||'',
        photo:product.photo||'',qty:1})
    }
    saveCart();
    showCartNotification(product.name);
}
function removeFromCart(key){cart=cart.filter(item=>item.key!==key);saveCart()}
function changeQty(key,delta){const item=cart.find(i=>i.key===key);if(!item)return;item.qty+=delta;if(item.qty<=0){cart=cart.filter(i=>i.key!==key)}saveCart()}
function clearCart(){if(cart.length===0)return;if(confirm('Очистить корзину?')){cart=[];saveCart();updateCartUI()}}
function updateCartUI(){
    const countEl=document.getElementById('t-cart-count');
    const itemsEl=document.getElementById('t-cart-items');
    const footerEl=document.getElementById('t-cart-footer');
    const totalEl=document.getElementById('t-cart-total');
    const totalItems=cart.reduce((sum,item)=>sum+item.qty,0);
    const totalPrice=cart.reduce((sum,item)=>sum+item.price*item.qty,0);
    if(totalItems>0){countEl.textContent=totalItems;countEl.classList.remove('hidden')}else{countEl.classList.add('hidden')}
    if(cart.length===0){itemsEl.innerHTML='<div class="t-cart-empty"><span class="t-icon-big">🛒</span>Корзина пуста<br><span style="font-size:13px;color:#9aaabb">Добавьте товары из каталога</span></div>';footerEl.style.display='none';return}
    let html='';
    cart.forEach(item=>{
        const params=[];if(item.color)params.push('🎨 '+item.color);if(item.gloss)params.push('✨ '+item.gloss);if(item.volume)params.push('📦 '+item.volume);const paramsStr=params.length?params.join(' · '):'';
        html+=`<div class="t-cart-item"><div class="t-cart-item-img"><img src="${item.photo||'https://static.tildacdn.com/tild6262-3633-4265-b336-363136653061/logo.png'}" alt="${item.name}" loading="lazy"></div><div class="t-cart-item-info"><div class="t-cart-item-name">${item.brand} ${item.name}</div><div class="t-cart-item-sku">Артикул: ${item.sku}</div>${paramsStr?`<div class="t-cart-item-params">${paramsStr}</div>`:''}</div><div class="t-cart-item-qty"><button onclick="changeQty('${item.key}',-1)">−</button><span>${item.qty}</span><button onclick="changeQty('${item.key}',1)">+</button></div><div class="t-cart-item-price">${(item.price*item.qty).toLocaleString()} ₽</div><button class="t-cart-item-remove" onclick="removeFromCart('${item.key}')" title="Удалить">✕</button></div>`;
    });
    itemsEl.innerHTML=html;footerEl.style.display='block';totalEl.textContent=totalPrice.toLocaleString()+' ₽';
}
function showCartNotification(name){
    const existing=document.querySelector('.t-cart-toast');if(existing)existing.remove();
    const toast=document.createElement('div');
    toast.className='t-cart-toast';
    toast.style.cssText='position:fixed;bottom:100px;right:100px;background:rgba(50,50,50,0.92);color:#fff;padding:10px 20px;border-radius:12px;font-size:14px;box-shadow:0 4px 16px rgba(0,0,0,0.2);z-index:99997;animation:slideUpCart .3s ease;font-weight:500;pointer-events:none;';
    toast.textContent='✅ '+name+' добавлен в корзину';
    document.body.appendChild(toast);
    setTimeout(()=>{toast.style.opacity='0';toast.style.transition='opacity .3s';setTimeout(()=>toast.remove(),300)},2000);
}
function toggleCart(){document.getElementById('t-cart-panel').classList.toggle('open')}
function openCheckout(){if(cart.length===0)return;const modal=document.getElementById('t-checkout-modal');document.getElementById('t-checkout-form-wrap').style.display='block';document.getElementById('t-checkout-success').style.display='none';modal.classList.add('active');document.body.style.overflow='hidden';const listEl=document.getElementById('t-checkout-items-list');let html='';cart.forEach(item=>{html+=`<div class="t-checkout-summary-item"><span>${item.brand} ${item.name} × ${item.qty}</span><span>${(item.price*item.qty).toLocaleString()} ₽</span></div>`});listEl.innerHTML=html;const total=cart.reduce((sum,item)=>sum+item.price*item.qty,0);document.getElementById('t-checkout-total').textContent=total.toLocaleString()+' ₽';}
function closeCheckout(){document.getElementById('t-checkout-modal').classList.remove('active');document.body.style.overflow=''}
function submitOrder(e){e.preventDefault();const name=document.getElementById('checkout-name').value.trim();const phone=document.getElementById('checkout-phone').value.trim();if(!name||!phone){alert('Пожалуйста, заполните имя и телефон');return}const orderData={name,phone,email:document.getElementById('checkout-email').value.trim(),comment:document.getElementById('checkout-comment').value.trim(),items:cart.map(item=>({brand:item.brand,name:item.name,sku:item.sku,price:item.price,qty:item.qty,color:item.color,gloss:item.gloss,volume:item.volume})),total:cart.reduce((sum,item)=>sum+item.price*item.qty,0),date:new Date().toISOString()};console.log('Заказ:',orderData);document.getElementById('t-checkout-form-wrap').style.display='none';document.getElementById('t-checkout-success').style.display='block';cart=[];saveCart();updateCartUI();document.getElementById('t-cart-panel').classList.remove('open');}
document.getElementById('t-checkout-modal').addEventListener('click',function(e){if(e.target===this)closeCheckout()});
document.addEventListener('click',function(e){const panel=document.getElementById('t-cart-panel');const fab=document.getElementById('t-cart-fab');if(panel.classList.contains('open')&&!panel.contains(e.target)&&!fab.contains(e.target)){panel.classList.remove('open')}});

// НАВИГАЦИЯ
function showPage(pageId){
    document.querySelectorAll('.t-page').forEach(p=>p.classList.remove('active'));
    const target=document.getElementById('page-'+pageId);
    if(target)target.classList.add('active');
    document.querySelectorAll('.t-nav-link').forEach(l=>l.classList.remove('active'));
    const link=document.querySelector('.t-nav-link[data-page="'+pageId+'"]');
    if(link)link.classList.add('active');
    if(pageId!=='home' && PRODUCTS_DATA[pageId]){
        renderProducts(pageId);
    }
    window.history.pushState(null,'','#section-'+pageId);
}
document.querySelectorAll('.t-nav-link').forEach(link=>{link.addEventListener('click',function(e){e.preventDefault();const page=this.dataset.page;if(page){showPage(page)}})});
window.addEventListener('popstate',function(){const hash=window.location.hash;if(hash.startsWith('#section-')){const page=hash.replace('#section-','');showPage(page)}});

// РЕНДЕРИНГ ТОВАРОВ
function renderProducts(categoryKey){
    const container=document.getElementById(categoryKey+'-grid');
    if(!container)return;
    const items=PRODUCTS_DATA[categoryKey];
    if(!items || items.length===0){container.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:40px;color:#6a7a8a;">⚠️ Товары в этой категории отсутствуют</div>';return}
    let html='';
    items.forEach((product,index)=>{
        const firstSize=product.sizes[0];
        const firstOpt=firstSize.options[0];
        const stock=firstOpt.stock||'Много';
        let stockClass='in-stock';
        let stockText='✅ В наличии';
        if(stock==='Под заказ'){stockClass='on-order';stockText='⏳ Под заказ'}
        else if(stock==='Мало'){stockClass='low-stock';stockText='⚠️ Мало'}
        const hasColors = product.colors && product.colors.length>0;
        const hasGloss = product.colors && product.colors.length>0 && product.selectorLabel;
        const glossLabel = product.selectorLabel || 'Блеск';
        html+=`<div class="t-product-card" data-container="${categoryKey}" data-index="${index}">
            <div class="t-product-image" onclick="event.stopPropagation(); openImageModal('${product.photo||''}')">
                <img src="${product.photo||''}" alt="${product.name}" loading="lazy" onerror="this.style.display='none'">
                <span class="t-zoom-hint">🔍</span>
            </div>
            <div class="t-product-brand">${product.brand}</div>
            <div class="t-product-name">${product.name}</div>
            <div class="t-product-sku">Артикул: ${firstOpt.sku}</div>
            <div class="t-product-stock ${stockClass}">${stockText}</div>
            <div class="t-selectors">
                ${hasGloss ? `<div class="t-select-group"><label>✨ ${glossLabel}</label><select class="t-select-gloss" data-container="${categoryKey}" data-index="${index}">${product.colors.map(c=>`<option value="${c}">${c}</option>`).join('')}</select></div>` : ''}
                <div class="t-select-group"><label>📦 Объём</label><select class="t-select-size" data-container="${categoryKey}" data-index="${index}">${product.sizes.map((s,i)=>`<option value="${i}">${s.volume} (${s.fill})</option>`).join('')}</select></div>
            </div>
            <div class="t-short-description">${(product.desc||'').substring(0,150)}...</div>
            <div class="t-full-description" id="full-${categoryKey}-${index}"><strong>📋 Описание:</strong><br>${product.desc||'Описание отсутствует'}<br><br><strong>Характеристики:</strong><br>${product.tech||''}</div>
            <table class="t-specs-table">
                <tr><td class="t-spec-label">Объём</td><td class="t-spec-value">${firstSize.volume}</td></tr>
                <tr><td class="t-spec-label">Наполнение</td><td class="t-spec-value">${firstSize.fill}</td></tr>
                <tr><td class="t-spec-label">Бренд</td><td class="t-spec-value">${product.brand}</td></tr>
                ${hasGloss ? `<tr><td class="t-spec-label">${glossLabel}</td><td class="t-spec-value">${firstOpt.color||'—'}</td></tr>` : ''}
                <tr><td class="t-spec-label">Наличие</td><td class="t-spec-value">${stockText}</td></tr>
            </table>
            <button class="t-btn-detail" data-container="${categoryKey}" data-index="${index}">📖 <span class="t-arrow">▼</span> Подробнее</button>
            <div class="t-product-footer">
                <div class="t-product-price" id="price-${categoryKey}-${index}">${firstOpt.price.toLocaleString()} <span class="t-currency">₽</span></div>
                <button class="t-btn-buy ${stock==='Под заказ'?'on-order':''}" data-container="${categoryKey}" data-index="${index}" ${stock==='Под заказ'?'disabled':''}>${stock==='Под заказ'?'⏳ Под заказ':'🛒 В корзину'}</button>
            </div>
        </div>`;
    });
    container.innerHTML=html;
    
    // Обработчики событий
    container.querySelectorAll('.t-select-gloss, .t-select-size').forEach(el=>{
        el.addEventListener('change',function(){
            const cat=this.dataset.container;
            const idx=parseInt(this.dataset.index);
            updateCard(cat,idx);
        });
    });
    container.querySelectorAll('.t-btn-buy:not(.on-order)').forEach(btn=>{
        btn.addEventListener('click',function(e){
            e.stopPropagation();
            const card=this.closest('.t-product-card');
            if(!card)return;
            const cat=card.dataset.container;
            const idx=parseInt(card.dataset.index);
            const pr=PRODUCTS_DATA[cat][idx];
            const glossSelect=card.querySelector('.t-select-gloss');
            const sizeSelect=card.querySelector('.t-select-size');
            const selectedGloss=glossSelect?glossSelect.value:'';
            const sizeIndex=sizeSelect?parseInt(sizeSelect.value):0;
            const sizeItem=pr.sizes[sizeIndex]||pr.sizes[0];
            let foundOpt=null;
            if(selectedGloss && pr.colors){
                for(let opt of sizeItem.options){
                    if(opt.color===selectedGloss){foundOpt=opt;break}
                }
            }
            if(!foundOpt)foundOpt=sizeItem.options[0];
            if(foundOpt.stock==='Под заказ'){alert('⏳ Этот товар доступен только под заказ.');return}
            addToCart({brand:pr.brand||'SYMPHONY',name:pr.name,sku:foundOpt.sku,price:foundOpt.price,color:foundOpt.color||'',gloss:foundOpt.gloss||'',volume:sizeItem.volume||'',fill:sizeItem.fill||'',photo:pr.photo||''});
        });
    });
    container.querySelectorAll('.t-btn-detail').forEach(btn=>{
        btn.addEventListener('click',function(e){
            e.stopPropagation();
            const cat=this.dataset.container;
            const idx=parseInt(this.dataset.index);
            const fd=document.getElementById('full-'+cat+'-'+idx);
            const ar=this.querySelector('.t-arrow');
            if(fd){
                if(fd.classList.contains('open')){
                    fd.classList.remove('open');
                    if(ar)ar.classList.remove('open');
                    this.innerHTML='📖 <span class="t-arrow">▼</span> Подробнее';
                }else{
                    document.querySelectorAll('.t-full-description.open').forEach(el=>el.classList.remove('open'));
                    document.querySelectorAll('.t-btn-detail').forEach(el=>{
                        const otherArrow=el.querySelector('.t-arrow');
                        if(otherArrow)otherArrow.classList.remove('open');
                        if(el!==btn)el.innerHTML='📖 <span class="t-arrow">▼</span> Подробнее';
                    });
                    fd.classList.add('open');
                    if(ar)ar.classList.add('open');
                    this.innerHTML='📖 <span class="t-arrow open">▲</span> Скрыть';
                }
            }
        });
    });
    container.querySelectorAll('.t-product-card').forEach(card=>{
        card.addEventListener('click',function(e){
            if(e.target.closest('.t-btn-buy')||e.target.closest('.t-btn-detail')||e.target.closest('select')||e.target.closest('.t-product-image')||e.target.closest('.t-selectors'))return;
            const cat=this.dataset.container;
            const idx=parseInt(this.dataset.index);
            openProductModal(cat,idx);
        });
    });
}

function updateCard(cat,idx){
    const pr=PRODUCTS_DATA[cat][idx];
    if(!pr)return;
    const card=document.querySelector('.t-product-card[data-container="'+cat+'"][data-index="'+idx+'"]');
    if(!card)return;
    const glossSelect=card.querySelector('.t-select-gloss');
    const sizeSelect=card.querySelector('.t-select-size');
    const selectedGloss=glossSelect?glossSelect.value:'';
    const sizeIndex=sizeSelect?parseInt(sizeSelect.value):0;
    const sizeItem=pr.sizes[sizeIndex]||pr.sizes[0];
    let foundOpt=null;
    if(selectedGloss && pr.colors){
        for(let opt of sizeItem.options){
            if(opt.color===selectedGloss){foundOpt=opt;break}
        }
    }
    if(!foundOpt)foundOpt=sizeItem.options[0];
    const stock=foundOpt.stock||'Много';
    let stockClass='in-stock',stockText='✅ В наличии';
    if(stock==='Под заказ'){stockClass='on-order';stockText='⏳ Под заказ'}
    else if(stock==='Мало'){stockClass='low-stock';stockText='⚠️ Мало'}
    const skuEl=card.querySelector('.t-product-sku');
    if(skuEl)skuEl.textContent='Артикул: '+foundOpt.sku;
    const priceEl=card.querySelector('.t-product-price');
    if(priceEl)priceEl.innerHTML=foundOpt.price.toLocaleString()+' <span class="t-currency">₽</span>';
    const stockEl=card.querySelector('.t-product-stock');
    if(stockEl){stockEl.textContent=stockText;stockEl.className='t-product-stock '+stockClass}
    const buyBtn=card.querySelector('.t-btn-buy');
    if(buyBtn){
        if(stock==='Под заказ'){buyBtn.className='t-btn-buy on-order';buyBtn.textContent='⏳ Под заказ';buyBtn.disabled=true}
        else{buyBtn.className='t-btn-buy';buyBtn.textContent='🛒 В корзину';buyBtn.disabled=false}
    }
    const tbl=card.querySelector('.t-specs-table');
    if(tbl){
        const rows=tbl.querySelectorAll('tr');
        const hasGloss=pr.colors && pr.colors.length>0;
        const glossLabel=pr.selectorLabel||'Блеск';
        let data=[['Объём',sizeItem.volume],['Наполнение',sizeItem.fill],['Бренд',pr.brand]];
        if(hasGloss)data.push([glossLabel,foundOpt.color||'—']);
        data.push(['Наличие',stockText]);
        for(let r=0;r<rows.length&&r<data.length;r++){
            const label=rows[r].querySelector('.t-spec-label');
            const value=rows[r].querySelector('.t-spec-value');
            if(label)label.textContent=data[r][0];
            if(value)value.textContent=data[r][1];
        }
    }
}

// МОДАЛЬНОЕ ОКНО
let currentModalCat=null,currentModalIdx=null;
function openProductModal(cat,idx){
    currentModalCat=cat;currentModalIdx=idx;
    const pr=PRODUCTS_DATA[cat][idx];
    if(!pr)return;
    const modal=document.getElementById('t-product-modal');
    const firstSize=pr.sizes[0];
    const firstOpt=firstSize.options[0];
    document.getElementById('modal-brand').textContent=pr.brand||'SYMPHONY';
    document.getElementById('modal-name').textContent=pr.name;
    document.getElementById('modal-sku').textContent='Артикул: '+firstOpt.sku;
    document.getElementById('modal-img').src=pr.photo||'';
    document.getElementById('modal-desc-text').textContent=pr.desc||'Описание отсутствует';
    const techItems=document.getElementById('modal-tech-items');
    techItems.innerHTML='';
    if(pr.tech){
        const lines=pr.tech.split('.').filter(s=>s.trim());
        lines.forEach(line=>{
            techItems.innerHTML+='<div class="t-tech-item"><span class="t-tech-label">•</span><span class="t-tech-value">'+line.trim()+'</span></div>';
        });
    }
    let html='';
    if(pr.colors && pr.colors.length>0 && pr.selectorLabel){
        html+='<select id="modal-gloss" onchange="updateModal()">';
        pr.colors.forEach(c=>html+='<option value="'+c+'">'+c+'</option>');
        html+='</select>';
    }
    html+='<select id="modal-size" onchange="updateModal()">';
    pr.sizes.forEach((s,i)=>html+='<option value="'+i+'">'+s.volume+' ('+s.fill+')</option>');
    html+='</select>';
    document.getElementById('modal-selectors').innerHTML=html;
    updateModal();
    modal.classList.add('active');
    document.body.style.overflow='hidden';
}
function closeProductModal(){document.getElementById('t-product-modal').classList.remove('active');document.body.style.overflow=''}
function updateModal(){
    if(!currentModalCat || currentModalIdx===null)return;
    const pr=PRODUCTS_DATA[currentModalCat][currentModalIdx];
    const glossSelect=document.getElementById('modal-gloss');
    const sizeSelect=document.getElementById('modal-size');
    const selectedGloss=glossSelect?glossSelect.value:'';
    const sizeIndex=sizeSelect?parseInt(sizeSelect.value):0;
    const sizeItem=pr.sizes[sizeIndex]||pr.sizes[0];
    let foundOpt=null;
    if(selectedGloss && pr.colors){
        for(let opt of sizeItem.options){
            if(opt.color===selectedGloss){foundOpt=opt;break}
        }
    }
    if(!foundOpt)foundOpt=sizeItem.options[0];
    const stock=foundOpt.stock||'Много';
    let stockClass='in-stock',stockText='✅ В наличии';
    if(stock==='Под заказ'){stockClass='on-order';stockText='⏳ Под заказ'}
    else if(stock==='Мало'){stockClass='low-stock';stockText='⚠️ Мало'}
    document.getElementById('modal-sku').textContent='Артикул: '+foundOpt.sku;
    document.getElementById('modal-price').innerHTML=foundOpt.price.toLocaleString()+' <span class="t-currency">₽</span>';
    document.getElementById('modal-price-large').innerHTML=foundOpt.price.toLocaleString()+' <span class="t-currency">₽</span>';
    const stockEl=document.getElementById('modal-stock');
    stockEl.textContent=stockText;stockEl.className='t-modal-stock '+stockClass;
    const buyBtn=document.getElementById('modal-buy-btn');
    if(stock==='Под заказ'){buyBtn.className='t-btn-buy on-order';buyBtn.textContent='⏳ Под заказ';buyBtn.disabled=true}
    else{buyBtn.className='t-btn-buy';buyBtn.textContent='🛒 В корзину';buyBtn.disabled=false}
}
function buyFromModal(){
    if(!currentModalCat || currentModalIdx===null)return;
    const pr=PRODUCTS_DATA[currentModalCat][currentModalIdx];
    const glossSelect=document.getElementById('modal-gloss');
    const sizeSelect=document.getElementById('modal-size');
    const selectedGloss=glossSelect?glossSelect.value:'';
    const sizeIndex=sizeSelect?parseInt(sizeSelect.value):0;
    const sizeItem=pr.sizes[sizeIndex]||pr.sizes[0];
    let foundOpt=null;
    if(selectedGloss && pr.colors){
        for(let opt of sizeItem.options){
            if(opt.color===selectedGloss){foundOpt=opt;break}
        }
    }
    if(!foundOpt)foundOpt=sizeItem.options[0];
    if(foundOpt.stock==='Под заказ'){alert('⏳ Этот товар доступен только под заказ.');return}
    addToCart({brand:pr.brand||'SYMPHONY',name:pr.name,sku:foundOpt.sku,price:foundOpt.price,color:foundOpt.color||'',gloss:foundOpt.gloss||'',volume:sizeItem.volume||'',fill:sizeItem.fill||'',photo:pr.photo||''});
    closeProductModal();
}
function openImageModal(src){const modal=document.getElementById('t-image-modal');const img=document.getElementById('t-image-modal-img');if(modal&&img&&src){img.src=src;modal.classList.add('active');document.body.style.overflow='hidden'}}
function closeImageModal(){const modal=document.getElementById('t-image-modal');if(modal){modal.classList.remove('active');document.body.style.overflow=''}}

// ПРОФИЛЬ
function tProfileLoad(){try{const data=localStorage.getItem('t_profile_data');if(data){const parsed=JSON.parse(data);if(parsed&&parsed.email)return parsed}}catch(e){}return null}
function tProfileSave(data){localStorage.setItem('t_profile_data',JSON.stringify(data))}
function tProfileLogin(){
    const email=document.getElementById('t-profile-email').value.trim();
    const password=document.getElementById('t-profile-password').value.trim();
    const message=document.getElementById('t-profile-message');
    if(!email||!password){message.textContent='⚠️ Заполните email и пароль';message.style.cssText='display:block;color:#e74c3c;font-size:11px;';return}
    const saved=tProfileLoad();
    if(!saved||saved.email!==email||saved.password!==password){message.textContent='❌ Неверный email или пароль';message.style.cssText='display:block;color:#e74c3c;font-size:11px;';return}
    tProfileShowDashboard(saved);message.style.display='none';
}
function tProfileRegister(){
    const email=document.getElementById('t-profile-email').value.trim();
    const password=document.getElementById('t-profile-password').value.trim();
    const message=document.getElementById('t-profile-message');
    if(!email||!password){message.textContent='⚠️ Заполните email и пароль';message.style.cssText='display:block;color:#e74c3c;font-size:11px;';return}
    if(password.length<6){message.textContent='⚠️ Пароль должен быть не менее 6 символов';message.style.cssText='display:block;color:#e74c3c;font-size:11px;';return}
    const userData={email:email,password:password,name:email.split('@')[0],registered:new Date().toISOString(),orders:[]};
    tProfileSave(userData);tProfileShowDashboard(userData);message.textContent='✅ Регистрация успешна!';message.style.cssText='display:block;color:#3d7a4a;font-size:11px;';
}
function tProfileLogout(){localStorage.removeItem('t_profile_data');document.getElementById('t-profile-login').style.display='block';document.getElementById('t-profile-dashboard').style.display='none';document.getElementById('t-profile-email').value='';document.getElementById('t-profile-password').value='';}
function tProfileShowDashboard(data){
    document.getElementById('t-profile-login').style.display='none';
    document.getElementById('t-profile-dashboard').style.display='block';
    document.getElementById('t-profile-name').textContent=data.name||'Пользователь';
    document.getElementById('t-profile-email-display').textContent=data.email;
    const ordersContainer=document.getElementById('t-profile-orders');
    if(data.orders&&data.orders.length>0){let html='';data.orders.forEach((order,i)=>{html+=`<div style="padding:4px 0;border-bottom:1px solid rgba(255,255,255,0.05);font-size:11px;"><strong>Заказ #${i+1}</strong> — ${order.date||'—'} <span style="color:#3d7a4a;">${order.total||0} ₽</span><span style="font-size:10px;color:rgba(255,255,255,0.3);">${order.status||'В обработке'}</span></div>`});ordersContainer.innerHTML=html}else{ordersContainer.innerHTML='<div style="padding:4px 0;color:rgba(255,255,255,0.4);font-size:11px;">У вас пока нет заказов.</div>'}}
document.addEventListener('DOMContentLoaded',function(){const saved=tProfileLoad();if(saved&&saved.email)tProfileShowDashboard(saved)});

// ПОИСК
const tSearchAllProducts=[];
async function tSearchLoadAllProducts(){
    if(tSearchAllProducts.length>0)return tSearchAllProducts;
    for(const cat of Object.keys(PRODUCTS_DATA)){
        const items=PRODUCTS_DATA[cat]||[];
        items.forEach(item=>{
            const firstSize=item.sizes&&item.sizes[0];
            const firstOpt=firstSize&&firstSize.options&&firstSize.options[0];
            if(firstOpt){
                tSearchAllProducts.push({category:cat,brand:item.brand||'SYMPHONY',name:item.name,sku:firstOpt.sku,photo:item.photo||'',stock:firstOpt.stock||'Много',url:'#'+cat});
            }
        });
    }
    return tSearchAllProducts;
}
function tSearchProducts(query){
    if(!query||query.length<2)return[];
    const q=query.toLowerCase().trim();
    return tSearchAllProducts.filter(item=>(item.name&&item.name.toLowerCase().includes(q))||(item.brand&&item.brand.toLowerCase().includes(q))||(item.sku&&item.sku.toLowerCase().includes(q))).slice(0,15);
}
function tSearchHeaderRenderResults(results){
    const container=document.getElementById('t-search-header-results');
    if(!container)return;
    if(results.length===0){container.innerHTML='<div style="padding:20px;text-align:center;color:rgba(255,255,255,0.5);font-size:13px;">😕 Ничего не найдено</div>';container.style.display='block';return}
    let html='';
    results.forEach(item=>{
        html+=`<a class="t-search-item" href="${item.url}" onclick="event.preventDefault(); tSearchHeaderGoToProduct('${item.category}','${item.sku}')" style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid rgba(255,255,255,0.05);cursor:pointer;transition:background .2s;text-decoration:none;color:rgba(255,255,255,0.9);">
            <img src="${item.photo}" alt="${item.name}" style="width:36px;height:36px;object-fit:contain;border-radius:6px;background:rgba(255,255,255,0.05);flex-shrink:0;" onerror="this.style.display='none'">
            <div style="flex:1;min-width:0;"><div style="font-weight:600;font-size:12px;">${item.brand} ${item.name}</div><div style="font-size:10px;color:rgba(255,255,255,0.4);">Артикул: ${item.sku}</div></div>
        </a>`;
    });
    container.innerHTML=html;container.style.display='block';
}
let tSearchDebounceTimer=null;
function tSearchHeaderHandleInput(){
    const input=document.getElementById('t-search-header-input');
    const container=document.getElementById('t-search-header-results');
    if(!input||!container)return;
    clearTimeout(tSearchDebounceTimer);
    const query=input.value;
    if(query.length<2){container.style.display='none';return}
    tSearchDebounceTimer=setTimeout(async ()=>{
        await tSearchLoadAllProducts();
        const results=tSearchProducts(query);
        tSearchHeaderRenderResults(results);
    },300);
}
function tSearchHeaderGoToProduct(category,sku){
    document.getElementById('t-search-header-results').style.display='none';
    document.getElementById('t-search-header-input').value='';
    const products=tSearchAllProducts.filter(p=>p.category===category&&p.sku===sku);
    if(products.length>0){
        const catItems=PRODUCTS_DATA[category]||[];
        const index=catItems.findIndex(p=>{
            const first=p.sizes&&p.sizes[0]&&p.sizes[0].options&&p.sizes[0].options[0];
            return first&&first.sku===sku;
        });
        if(index!==-1){openProductModal(category,index);return}
    }
    window.location.hash='section-'+category;
}
document.addEventListener('click',function(e){const container=document.getElementById('t-search-header-container');const results=document.getElementById('t-search-header-results');if(container&&results&&!container.contains(e.target)){results.style.display='none'}});
document.addEventListener('DOMContentLoaded',function(){const input=document.getElementById('t-search-header-input');if(input){input.addEventListener('input',tSearchHeaderHandleInput);input.addEventListener('keydown',function(e){if(e.key==='Enter'){const results=document.getElementById('t-search-header-results');const firstItem=results?results.querySelector('.t-search-item'):null;if(firstItem)firstItem.click()}})}});

// ============================================================
// ЗАПУСК
// ============================================================
document.addEventListener('DOMContentLoaded',function(){
    loadCart();
    const hash=window.location.hash;
    let startPage='home';
    if(hash.startsWith('#section-')){
        const page=hash.replace('#section-','');
        if(document.getElementById('page-'+page)) startPage=page;
    }
    showPage(startPage);
    console.log('✅ Каталог загружен! Раздел "Лаки" содержит '+PRODUCTS_DATA.laki.length+' товаров.');
});
</script>
