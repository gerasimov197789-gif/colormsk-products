@media(max-width:900px){.t-header{padding:10px 16px;flex-direction:column;align-items:stretch;gap:8px}.t-header .t-logo a{font-size:22px}.t-header .t-contacts{justify-content:center;gap:12px}.t-product-modal .t-modal-grid{flex-direction:column}.t-product-modal .t-modal-image{height:140px;flex:none;width:100%}.t-product-modal .t-modal-content{padding:18px}.t-home-grid{grid-template-columns:repeat(2,1fr)}.t-home-image-wrapper{height:160px}.t-home-title{font-size:16px}.t-products-grid{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}}
