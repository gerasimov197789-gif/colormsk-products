<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>КолорМСК — Каталог ЛКМ</title>
<style>
/* ===== ВСЕ СТИЛИ (полная копия из вашего файла) ===== */
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background-image:url('https://static.tildacdn.com/tild6161-6432-4533-b862-316337626235/photo.jpg');background-size:cover;background-position:center;background-attachment:fixed;background-repeat:no-repeat;background-color:#f5f5f5;color:#1a2a3a;min-height:100vh}
.t-header{background:rgba(255,255,255,0);padding:10px 30px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:2px solid rgba(200,200,200,0);position:sticky;top:0;z-index:1000}
.t-header .t-logo{display:flex;align-items:center;gap:12px}
.t-header .t-logo .t-logo-img{height:40px;width:auto;border-radius:4px}
.t-header .t-logo a{font-size:26px;font-weight:700;color:#fff;text-decoration:none;display:flex;align-items:center;gap:8px}
.t-header .t-logo a span{color:#aaa}
.t-header .t-logo .t-slogan{font-size:11px;color:rgba(255,255,255,0.6)}
.t-header .t-contacts{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.t-header .t-contacts a{color:rgba(255,255,255,0.8);text-decoration:none;font-size:13px;transition:color .2s;display:flex;align-items:center;gap:6px}
.t-header .t-contacts a:hover{color:#fff}
.t-layout{display:flex;max-width:100%;min-height:100vh;background:0 0;width:100%;align-items:stretch}
.t-sidebar{width:210px;min-width:210px;background:rgba(26,42,58,0.85);padding:20px 0 0;position:sticky;top:0;align-self:stretch;min-height:100vh;overflow-y:auto;display:flex;flex-direction:column;z-index:100;backdrop-filter:blur(10px)}
.t-sidebar-nav{display:flex;flex-direction:column;gap:2px;padding:0 10px;flex:1}
.t-nav-link{display:flex;align-items:center;gap:10px;padding:8px 14px;border-radius:10px;color:rgba(255,255,255,0.65);text-decoration:none;font-size:13px;font-weight:500;transition:all .2s;background:0 0;cursor:pointer;width:100%;font-family:inherit}
.t-nav-link:hover{background:rgba(255,255,255,0.08);color:#fff}
.t-nav-link.active{background:rgba(200,200,200,0.15);color:#ddd}
.t-sidebar-footer{display:none!important}
.t-main-wrap{flex:1;display:flex;min-width:0;width:100%}
.t-main{flex:1;padding:20px 24px 30px;min-width:0;background:0 0;margin-top:-10px}
.t-page{display:none;animation:fadeIn .3s ease}
.t-page.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.t-home-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:0}
.t-home-card{background:rgba(255,255,255,0.95);border-radius:16px;padding:20px 16px 24px;text-align:center;border:1px solid rgba(255,255,255,0.3);box-shadow:0 4px 15px rgba(0,0,0,0.06);transition:transform .3s,box-shadow .3s;cursor:pointer;text-decoration:none;color:#1a2a3a;display:flex;flex-direction:column;align-items:center;gap:12px;backdrop-filter:blur(4px)}
.t-home-card:hover{transform:translateY(-6px);box-shadow:0 12px 35px rgba(0,0,0,0.12);background:rgba(255,255,255,1)}
.t-home-image-wrapper{width:100%;height:200px;overflow:hidden;border-radius:12px;background:#f8faff;display:flex;align-items:center;justify-content:center}
.t-home-image{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.t-home-card:hover .t-home-image{transform:scale(1.06)}
.t-home-title{font-size:18px;font-weight:600;color:#1a2a3a}
.t-home-desc{font-size:13px;color:#6a7a8a}
.t-products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;width:100%;margin:0 auto;padding-top:0}
.t-product-card{background:rgba(255,255,255,0.95);border-radius:14px;padding:16px 18px 18px;border:1px solid rgba(255,255,255,0.3);box-shadow:0 2px 8px rgba(0,0,0,0.06);transition:transform .25s,box-shadow .25s;display:flex;flex-direction:column;cursor:pointer;backdrop-filter:blur(4px);height:100%;min-height:420px}
.t-product-card:hover{transform:translateY(-4px);box-shadow:0 10px 30px rgba(0,0,0,0.1)}
.t-product-image{width:100%;height:150px;overflow:hidden;border-radius:10px;margin-bottom:10px;background:#f8faff;border:1px solid #eaedf2;display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative}
.t-product-image img{width:100%;height:100%;object-fit:contain;transition:transform .3s}
.t-product-image:hover img{transform:scale(1.05)}
.t-product-image .t-zoom-hint{position:absolute;bottom:6px;right:6px;background:rgba(0,0,0,0.6);color:#fff;padding:2px 8px;border-radius:12px;font-size:9px;opacity:0;transition:opacity .3s}
.t-product-image:hover .t-zoom-hint{opacity:1}
.t-product-brand{font-size:16px;font-weight:700;color:#1a2a3a;margin-bottom:2px}
.t-product-name{font-size:14px;font-weight:600;color:#2c3e50;line-height:1.3;margin:0 0 3px;min-height:36px}
.t-product-sku{font-size:11px;color:#9aaabb;margin-bottom:3px}
.t-product-stock{font-size:11px;font-weight:500;padding:2px 10px;border-radius:20px;display:inline-block;margin-bottom:4px}
.t-product-stock.in-stock{color:#3d7a4a;background:rgba(61,122,74,0.12)}
.t-product-stock.low-stock{color:#d4880f;background:rgba(212,136,15,0.12)}
.t-product-stock.on-order{color:#e74c3c;background:rgba(231,76,60,0.12)}
.t-selectors{display:flex;flex-wrap:wrap;gap:4px;margin:4px 0 6px}
.t-select-group{flex:1;min-width:60px}
.t-select-group label{display:block;font-size:9px;font-weight:600;color:#6a7a8a;text-transform:uppercase;letter-spacing:.2px}
.t-select-group select{width:100%;padding:2px 4px;border:2px solid #dce3ec;border-radius:5px;background:#f8faff;font-size:11px;color:#1a2a3a;font-family:inherit;cursor:pointer;transition:border-color .2s}
.t-select-group select:focus{outline:0;border-color:#999}
.t-short-description{font-size:12px;color:#4a5a6a;line-height:1.3;margin:2px 0 4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:32px}
.t-full-description{font-size:12px;color:#4a5a6a;line-height:1.4;margin:4px 0 6px;padding:8px 12px;background:rgba(248,250,255,0.95);border-radius:6px;border-left:3px solid #999;display:none;position:relative;z-index:5;box-shadow:0 2px 8px rgba(0,0,0,0.06)}
.t-full-description.open{display:block}
.t-specs-table{width:100%;border-collapse:collapse;margin:2px 0 4px;font-size:11px;border-radius:4px;overflow:hidden}
.t-specs-table td{padding:2px 6px;border-bottom:1px solid #f0f2f5}
.t-specs-table tr:last-child td{border-bottom:none}
.t-specs-table .t-spec-label{font-weight:600;color:#1a2a3a;width:38%;background:rgba(248,250,255,0.9);font-size:10px}
.t-specs-table .t-spec-value{color:#3d5166;background:rgba(255,255,255,0.9);font-size:10px}
.t-product-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px;padding-top:8px;border-top:1px solid #eaedf2;margin-top:4px}
.t-product-price{font-size:18px;font-weight:700;color:#1a2a3a}
.t-product-price .t-currency{font-size:13px;font-weight:400;color:#6a7a8a}
.t-btn-buy{background:#d0d5dd;color:#1a2a3a;border:none;border-radius:6px;padding:6px 16px;font-size:12px;font-weight:600;cursor:pointer;transition:background .2s;font-family:inherit}
.t-btn-buy:hover{background:#b8bfc9}
.t-btn-buy.on-order{background:#d0d5dd;color:#6a7a8a;cursor:default;pointer-events:none;opacity:0.6}
.t-btn-detail{background:rgba(232,236,242,0.9);color:#1a2a3a;border:none;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;transition:background .2s;font-family:inherit;width:100%;margin-top:4px}
.t-btn-detail:hover{background:#d0d6de}
.t-btn-detail .t-arrow{display:inline-block;transition:transform .3s}
.t-btn-detail .t-arrow.open{transform:rotate(180deg)}
.t-sidebar-right{width:210px;min-width:210px;background:rgba(26,42,58,0.85);padding:20px 16px 0;position:sticky;top:0;align-self:stretch;min-height:100vh;overflow-y:auto;display:flex;flex-direction:column;gap:12px;backdrop-filter:blur(10px)}
.t-sidebar-right .t-sidebar-title{font-size:11px;font-weight:600;color:rgba(255,255,255,0.3);text-transform:uppercase;letter-spacing:1px;padding-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.06)}
.t-sidebar-card{background:rgba(255,255,255,0.05);border-radius:12px;padding:12px;border:1px solid rgba(255,255,255,0.06);transition:transform .2s,background .2s}
.t-sidebar-card:hover{background:rgba(255,255,255,0.08);transform:translateY(-2px)}
.t-sidebar-card h3{font-size:13px;font-weight:700;color:#fff;margin-bottom:4px;display:flex;align-items:center;gap:6px}
.t-sidebar-card p{font-size:11px;color:rgba(255,255,255,0.6);line-height:1.4;margin-bottom:8px}
.t-sidebar-card .t-btn-link{display:inline-block;background:rgba(200,200,200,0.2);color:#ccc;padding:5px 12px;border-radius:6px;text-decoration:none;font-weight:600;font-size:11px;transition:background .2s;text-align:center;width:100%;border:1px solid rgba(200,200,200,0.15)}
.t-sidebar-card .t-btn-link:hover{background:rgba(200,200,200,0.3);color:#fff}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
.t-image-modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.92);z-index:999999;justify-content:center;align-items:center;padding:30px;cursor:pointer}
.t-image-modal.active{display:flex}
.t-image-modal .t-image-modal-close{position:fixed;top:20px;right:30px;background:0 0;border:none;color:#fff;font-size:44px;cursor:pointer;z-index:1000000}
.t-image-modal .t-image-modal-img{max-width:95vw;max-height:90vh;object-fit:contain;border-radius:8px;box-shadow:0 20px 60px rgba(0,0,0,0.5);cursor:default}
.t-product-modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:99999;justify-content:center;align-items:center;padding:30px;overflow-y:auto}
.t-product-modal.active{display:flex}
.t-product-modal .t-modal-content{background:rgba(255,255,255,0.97);border-radius:20px;max-width:800px;width:100%;max-height:95vh;overflow-y:auto;padding:30px;position:relative;animation:slideUp .3s ease;backdrop-filter:blur(10px)}
@keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
.t-product-modal .t-modal-close{position:sticky;top:0;float:right;background:0 0;border:none;font-size:32px;cursor:pointer;color:#999;padding:0 0 0 20px;z-index:10;transition:transform .2s,color .2s}
.t-product-modal .t-modal-close:hover{color:#000;transform:rotate(90deg)}
.t-product-modal .t-modal-brand{font-size:18px;font-weight:700;color:#555}
.t-product-modal .t-modal-name{font-size:24px;font-weight:700;color:#1a2a3a;margin:4px 0 2px;line-height:1.2}
.t-product-modal .t-modal-sku{font-size:13px;color:#999;margin-bottom:10px}
.t-product-modal .t-modal-grid{display:flex;gap:20px;flex-wrap:wrap}
.t-product-modal .t-modal-image{flex:0 0 180px;min-width:130px;background:#f8faff;border-radius:12px;border:1px solid #eaedf2;display:flex;align-items:center;justify-content:center;height:180px;overflow:hidden;cursor:pointer;position:relative}
.t-product-modal .t-modal-image img{width:100%;height:100%;object-fit:contain}
.t-product-modal .t-modal-image .t-modal-zoom-hint{position:absolute;bottom:6px;right:6px;background:rgba(0,0,0,0.6);color:#fff;padding:3px 8px;border-radius:12px;font-size:10px}
.t-product-modal .t-modal-info{flex:1;min-width:160px}
.t-product-modal .t-modal-price{font-size:28px;font-weight:700;color:#1a2a3a;margin-bottom:4px}
.t-product-modal .t-modal-price .t-currency{font-size:16px;font-weight:400;color:#6a7a8a}
.t-product-modal .t-modal-stock{font-size:13px;font-weight:600;padding:3px 12px;border-radius:20px;display:inline-block;margin:2px 0 6px}
.t-product-modal .t-modal-stock.in-stock{color:#3d7a4a;background:rgba(61,122,74,0.12)}
.t-product-modal .t-modal-stock.low-stock{color:#d4880f;background:rgba(212,136,15,0.12)}
.t-product-modal .t-modal-stock.on-order{color:#e74c3c;background:rgba(231,76,60,0.12)}
.t-product-modal .t-modal-selectors select{width:100%;padding:6px 10px;border:2px solid #dce3ec;border-radius:8px;font-size:13px;font-family:inherit;margin-bottom:4px;background:#f8faff;cursor:pointer}
.t-product-modal .t-modal-selectors select:focus{outline:0;border-color:#999}
.t-product-modal .t-modal-description-full{padding:12px 16px;background:rgba(248,250,255,0.9);border-radius:10px;border-left:4px solid #999;margin:10px 0;font-size:14px;line-height:1.6;color:#2c3e50}
.t-product-modal .t-modal-tech-full{padding:12px 16px;background:rgba(248,250,255,0.9);border-radius:10px;border:1px solid #eaedf2;margin:8px 0;font-size:13px;color:#3d5166;line-height:1.6}
.t-product-modal .t-modal-tech-full .t-tech-item{display:flex;justify-content:space-between;padding:2px 0;border-bottom:1px dashed #eaeef3}
.t-product-modal .t-modal-tech-full .t-tech-item:last-child{border-bottom:none}
.t-product-modal .t-modal-tech-full .t-tech-label{font-weight:600;color:#1a2a3a}
.t-product-modal .t-modal-tech-full .t-tech-value{color:#4a5a6a}
.t-product-modal .t-modal-buy{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-top:12px;border-top:2px solid #eaedf2;margin-top:4px}
.t-product-modal .t-modal-buy .t-btn-buy{background:#d0d5dd;color:#1a2a3a;border:none;border-radius:10px;padding:12px 30px;font-size:16px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .2s}
.t-product-modal .t-modal-buy .t-btn-buy:hover{background:#b8bfc9}
.t-product-modal .t-modal-buy .t-btn-buy.on-order{background:#d0d5dd;color:#6a7a8a;cursor:default;pointer-events:none;opacity:0.6}
.t-product-modal .t-modal-price-large{font-size:26px;font-weight:700;color:#1a2a3a}
.t-product-modal .t-modal-price-large .t-currency{font-size:16px;font-weight:400;color:#6a7a8a}
.t-cart-fab{position:fixed;bottom:30px;right:30px;z-index:99999;background:#d0d5dd;color:#1a2a3a;width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;box-shadow:0 6px 24px rgba(0,0,0,0.25);cursor:pointer;transition:transform .3s,box-shadow .3s;border:none}
.t-cart-fab:hover{transform:scale(1.08);box-shadow:0 8px 32px rgba(0,0,0,0.3)}
.t-cart-fab .t-cart-count{position:absolute;top:-4px;right:-4px;background:#e74c3c;color:#fff;font-size:11px;font-weight:700;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(231,76,60,0.4)}
.t-cart-fab .t-cart-count.hidden{display:none}
.t-cart-panel{position:fixed;bottom:90px;right:30px;width:400px;max-height:65vh;background:rgba(255,255,255,0.97);backdrop-filter:blur(16px);border-radius:16px;box-shadow:0 12px 48px rgba(0,0,0,0.25);z-index:99998;display:none;flex-direction:column;overflow:hidden;border:1px solid rgba(255,255,255,0.2)}
.t-cart-panel.open{display:flex;animation:slideUpCart .3s ease}
@keyframes slideUpCart{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.t-cart-panel .t-cart-header{padding:14px 18px;border-bottom:1px solid #eaedf2;display:flex;justify-content:space-between;align-items:center;background:rgba(248,250,255,0.8)}
.t-cart-panel .t-cart-header h3{font-size:17px;font-weight:700;color:#1a2a3a}
.t-cart-panel .t-cart-header .t-cart-close{background:0 0;border:none;font-size:22px;cursor:pointer;color:#999;transition:color .2s;padding:0 6px}
.t-cart-panel .t-cart-header .t-cart-close:hover{color:#1a2a3a}
.t-cart-panel .t-cart-items{flex:1;overflow-y:auto;padding:10px 14px;max-height:300px}
.t-cart-panel .t-cart-empty{padding:30px 20px;text-align:center;color:#6a7a8a;font-size:14px}
.t-cart-panel .t-cart-empty .t-icon-big{font-size:40px;display:block;margin-bottom:10px}
.t-cart-item{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #f0f2f5;align-items:center}
.t-cart-item:last-child{border-bottom:none}
.t-cart-item .t-cart-item-img{width:40px;height:40px;border-radius:6px;background:#f8faff;border:1px solid #eaedf2;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
.t-cart-item .t-cart-item-img img{width:100%;height:100%;object-fit:contain}
.t-cart-item .t-cart-item-info{flex:1;min-width:0}
.t-cart-item .t-cart-item-info .t-cart-item-name{font-size:12px;font-weight:600;color:#1a2a3a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.t-cart-item .t-cart-item-info .t-cart-item-sku{font-size:10px;color:#9aaabb}
.t-cart-item .t-cart-item-info .t-cart-item-params{font-size:11px;color:#6a7a8a}
.t-cart-item .t-cart-item-qty{display:flex;align-items:center;gap:4px}
.t-cart-item .t-cart-item-qty button{width:22px;height:22px;border-radius:50%;border:1px solid #dce3ec;background:#f8faff;cursor:pointer;font-size:12px;font-weight:700;color:#1a2a3a;transition:all .2s;display:flex;align-items:center;justify-content:center}
.t-cart-item .t-cart-item-qty button:hover{background:#d0d5dd;color:#1a2a3a;border-color:#b8bfc9}
.t-cart-item .t-cart-item-qty span{font-size:13px;font-weight:600;color:#1a2a3a;min-width:24px;text-align:center}
.t-cart-item .t-cart-item-price{font-size:14px;font-weight:700;color:#1a2a3a;min-width:70px;text-align:right}
.t-cart-item .t-cart-item-remove{background:0 0;border:none;color:#ccc;cursor:pointer;font-size:16px;transition:color .2s;padding:0 4px}
.t-cart-item .t-cart-item-remove:hover{color:#e74c3c}
.t-cart-footer{padding:12px 18px;border-top:1px solid #eaedf2;background:rgba(248,250,255,0.8)}
.t-cart-footer .t-cart-total{display:flex;justify-content:space-between;font-size:17px;font-weight:700;color:#1a2a3a;margin-bottom:8px}
.t-cart-footer .t-cart-total .t-cart-total-price{color:#1a2a3a}
.t-cart-footer .t-cart-actions{display:flex;gap:8px}
.t-cart-footer .t-cart-actions button{flex:1;padding:8px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .2s;border:none}
.t-cart-footer .t-cart-clear{background:#e74c3c;color:#fff}
.t-cart-footer .t-cart-clear:hover{background:#c0392b}
.t-cart-footer .t-cart-checkout{background:#d0d5dd;color:#1a2a3a;flex:2}
.t-cart-footer .t-cart-checkout:hover{background:#b8bfc9}
.t-checkout-modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:999999;justify-content:center;align-items:center;padding:20px}
.t-checkout-modal.active{display:flex}
.t-checkout-modal .t-checkout-content{background:rgba(255,255,255,0.98);backdrop-filter:blur(16px);border-radius:20px;max-width:500px;width:100%;max-height:95vh;overflow-y:auto;padding:28px;position:relative;animation:slideUp .3s ease}
.t-checkout-modal .t-checkout-close{position:absolute;top:14px;right:18px;background:0 0;border:none;font-size:26px;cursor:pointer;color:#999;transition:color .2s}
.t-checkout-modal .t-checkout-close:hover{color:#1a2a3a}
.t-checkout-modal h2{font-size:22px;font-weight:700;color:#1a2a3a;margin-bottom:4px}
.t-checkout-modal .t-checkout-sub{color:#6a7a8a;font-size:13px;margin-bottom:16px}
.t-checkout-modal .t-checkout-form label{display:block;font-size:12px;font-weight:600;color:#1a2a3a;margin-bottom:3px}
.t-checkout-modal .t-checkout-form input,.t-checkout-modal .t-checkout-form textarea{width:100%;padding:8px 12px;border:2px solid #dce3ec;border-radius:8px;font-size:13px;font-family:inherit;margin-bottom:10px;transition:border-color .2s;background:#f8faff}
.t-checkout-modal .t-checkout-form input:focus,.t-checkout-modal .t-checkout-form textarea:focus{outline:0;border-color:#999}
.t-checkout-modal .t-checkout-form textarea{resize:vertical;min-height:60px}
.t-checkout-modal .t-checkout-summary{background:rgba(248,250,255,0.9);border-radius:10px;padding:12px 14px;margin-bottom:14px}
.t-checkout-modal .t-checkout-summary .t-checkout-summary-item{display:flex;justify-content:space-between;font-size:13px;padding:2px 0;color:#4a5a6a}
.t-checkout-modal .t-checkout-summary .t-checkout-summary-total{display:flex;justify-content:space-between;font-size:17px;font-weight:700;color:#1a2a3a;padding-top:6px;border-top:2px solid #eaedf2;margin-top:4px}
.t-checkout-modal .t-checkout-submit{width:100%;padding:12px;background:#d0d5dd;color:#1a2a3a;border:none;border-radius:10px;font-size:16px;font-weight:600;cursor:pointer;transition:background .2s;font-family:inherit}
.t-checkout-modal .t-checkout-submit:hover{background:#b8bfc9}
.t-checkout-modal .t-checkout-success{display:none;text-align:center;padding:30px 20px}
.t-checkout-modal .t-checkout-success .t-icon-big{font-size:56px;display:block;margin-bottom:10px}
.t-checkout-modal .t-checkout-success h3{font-size:20px;color:#3d7a4a;margin-bottom:4px}
.t-checkout-modal .t-checkout-success p{color:#6a7a8a;font-size:13px}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
